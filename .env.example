PORT=5000
# Local MongoDB connection string example:
# MONGO_URI=mongodb://127.0.0.1:27017/task-manager-db

# MongoDB Atlas connection string example (Replace <db_username> with your MongoDB database username):
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.wcyiyc0.mongodb.net/task-manager-db?retryWrites=true&w=majority

# JWT Authentication Secret and Token Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# AI Service Integration API Key (OpenAI / Groq / Gemini - Practical 13)
# The key is kept strictly server-side and never exposed to the frontend
AI_API_KEY=your_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
